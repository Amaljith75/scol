          {
           "id": "kerala-scert/class-3/maths/00-sample-equal-groups/01-equal-groups",
           "minutes": 5,
           "objective": {
            "en": "Count objects arranged in equal groups.",
            "ml": "തുല്യ കൂട്ടങ്ങളായി വെച്ച വസ്തുക്കൾ എണ്ണുക."
           },
           "steps": [
            {
             "t": "say",
             "text": {
              "en": "Look! I have 3 baskets. Each basket has 4 mangoes.",
              "ml": "നോക്കൂ! എന്റെ കയ്യിൽ 3 കൊട്ടകളുണ്ട്. ഓരോ കൊട്ടയിലും 4 മാങ്ങ വീതം."
             },
             "visual": {
              "args": [
               "3",
               "4",
               "🥭"
              ],
              "kind": "groups"
             }
            },
            {
             "t": "say",
             "text": {
              "en": "Every basket has the same number of mangoes. We call these equal groups.",
              "ml": "എല്ലാ കൊട്ടയിലും ഒരേ എണ്ണം മാങ്ങയുണ്ട്. ഇവയെ തുല്യ കൂട്ടങ്ങൾ എന്ന് പറയും."
             },
             "visual": {
              "args": [
               "3",
               "4",
               "🥭"
              ],
              "kind": "groups"
             }
            },
            {
             "answer": "12",
             "concept": "kerala-scert/class-3/maths#equal-groups",
             "explain": {
              "en": "4 and 4 and 4 make 12. Three equal groups of 4 is 12.",
              "ml": "4-ഉം 4-ഉം 4-ഉം ചേർന്നാൽ 12. നാലിന്റെ മൂന്ന് കൂട്ടങ്ങൾ 12 ആണ്."
             },
             "form": "choice",
             "hint": {
              "en": "Count basket by basket: 4, then 8, then...",
              "ml": "ഓരോ കൊട്ടയായി എണ്ണൂ: 4, പിന്നെ 8, പിന്നെ..."
             },
             "level": 1,
             "mistakes": {
              "34": "joined the two numbers together",
              "7": "added 3 and 4 instead of counting every group"
             },
             "options": [
              "7",
              "12",
              "34"
             ],
             "t": "ask",
             "text": {
              "en": "How many mangoes are there in all?",
              "ml": "ആകെ എത്ര മാങ്ങയുണ്ട്?"
             },
             "visual": {
              "args": [
               "3",
               "4",
               "🥭"
              ],
              "kind": "groups"
             }
            },
            {
             "answer": "10",
             "concept": "kerala-scert/class-3/maths#equal-groups",
             "explain": {
              "en": "5 and 5 make 10.",
              "ml": "5-ഉം 5-ഉം ചേർന്നാൽ 10."
             },
             "form": "number",
             "hint": {
              "en": "Count the first plate, then keep counting on the second plate.",
              "ml": "ആദ്യത്തെ പാത്രം എണ്ണൂ, പിന്നെ രണ്ടാമത്തേതിൽ തുടർന്ന് എണ്ണൂ."
             },
             "level": 1,
             "mistakes": {
              "7": "added 2 and 5 instead of counting every group"
             },
             "t": "ask",
             "text": {
              "en": "2 plates. 5 laddus on each plate. How many laddus altogether?",
              "ml": "2 പാത്രങ്ങൾ. ഓരോ പാത്രത്തിലും 5 ലഡ്ഡു. ആകെ എത്ര ലഡ്ഡു?"
             },
             "visual": {
              "args": [
               "2",
               "5",
               "🟡"
              ],
              "kind": "groups"
             }
            },
            {
             "answer": "5 + 5 + 5",
             "concept": "kerala-scert/class-3/maths#equal-groups",
             "explain": {
              "en": "3 groups of 5 means 5, three times: 5 + 5 + 5.",
              "ml": "അഞ്ചിന്റെ 3 കൂട്ടങ്ങൾ എന്നാൽ 5 മൂന്ന് തവണ: 5 + 5 + 5."
             },
             "form": "choice",
             "hint": {
              "en": "Imagine 3 bags. Each bag has 5 things.",
              "ml": "3 സഞ്ചികൾ സങ്കൽപ്പിക്കൂ. ഓരോന്നിലും 5 സാധനങ്ങൾ."
             },
             "level": 2,
             "mistakes": {
              "3 + 5": "added the two numbers instead of repeating the group",
              "35": "joined the two numbers together"
             },
             "options": [
              "5 + 5 + 5",
              "3 + 5",
              "35"
             ],
             "t": "ask",
             "text": {
              "en": "Which one means the same as 3 groups of 5?",
              "ml": "അഞ്ചിന്റെ 3 കൂട്ടങ്ങൾ എന്നതിന് തുല്യമായത് ഏത്?"
             }
            },
            {
             "answer": "8",
             "concept": "kerala-scert/class-3/maths#equal-groups",
             "explain": {
              "en": "2 and 2 and 2 and 2 make 8.",
              "ml": "2-ഉം 2-ഉം 2-ഉം 2-ഉം ചേർന്നാൽ 8."
             },
             "form": "number",
             "hint": {
              "en": "Try drawing 4 bags and putting 2 dots in each.",
              "ml": "4 സഞ്ചികൾ വരച്ച് ഓരോന്നിലും 2 കുത്തുകൾ ഇട്ടു നോക്കൂ."
             },
             "level": 2,
             "mistakes": {
              "6": "added 4 and 2 instead of counting every group"
             },
             "t": "ask",
             "text": {
              "en": "There are 4 bags. Each bag has 2 balls. How many balls?",
              "ml": "4 സഞ്ചികളുണ്ട്. ഓരോ സഞ്ചിയിലും 2 പന്തുകൾ. ആകെ എത്ര പന്തുകൾ?"
             },
             "visual": {
              "args": [
               "4",
               "2",
               "⚽"
              ],
              "kind": "groups"
             }
            }
           ],
           "title": {
            "en": "Equal groups",
            "ml": "തുല്യ കൂട്ടങ്ങൾ"
           }
