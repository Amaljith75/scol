           "minutes": 4,
           "steps": [
            {
             "t": "say",
             "text": {
              "en": "When we count in tens, we jump ten steps each time: 10, 20, 30, 40."
             },
             "visual": {
              "args": [
               "0",
               "50",
               "30"
              ],
              "kind": "numberline"
             }
            },
            {
             "label": "example",
             "t": "say",
             "text": {
              "en": "3 jumps of ten take us to 30."
             }
            },
            {
             "answer": "50",
             "concept": "cbse/class-3/maths#counting-in-tens",
             "form": "number",
             "hint": {
              "en": "Jump ten more steps from 40."
             },
             "level": 1,
             "t": "ask",
             "text": {
              "en": "What comes after 40 when we count in tens?"
             }
            },
            {
             "answer": "50",
             "concept": "cbse/class-3/maths#counting-in-tens",
             "form": "choice",
             "level": 1,
             "options": [
              "30",
              "50"
